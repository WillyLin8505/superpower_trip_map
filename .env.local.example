# AI — REQUIRED for 分析行程 (place extraction). lib/claude.ts uses `new Anthropic()`,
# which reads ANTHROPIC_API_KEY by default. WITHOUT it, "分析行程" fails and the input
# page shows no places. Restart the dev server after changing env.
ANTHROPIC_API_KEY=sk-ant-...

GOOGLE_MAPS_API_KEY=your_server_side_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_client_side_key_here
# Cost controls:
# - Default outside tests is safe: Distance Matrix uses haversine approximation.
# - Set live only if you accept Distance Matrix element billing.
GOOGLE_MAPS_DISTANCE_MATRIX_MODE=haversine
# - Default outside tests is nearby-only: recommendation cards use Nearby Search data
#   without per-card Place Details calls. Set live for richer hours/descriptions.
GOOGLE_MAPS_RECOMMENDATION_DETAILS_MODE=nearby-only
# - Server/CDN cache TTL for Google Places/Photos fetches.
GOOGLE_MAPS_CACHE_SECONDS=86400
# Stores only hashed lookup input + Google place_id in Supabase. No Google names,
# addresses, photos, coordinates, or reviews are stored in this cache.
GOOGLE_MAPS_PLACE_ID_CACHE_MODE=on
# Logs server-side Google/API calls to public.api_usage_events for cost auditing.
# Default is on outside tests. Set off only for emergency write-volume reduction.
API_USAGE_EVENTS_MODE=on
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated allowlist of admin emails for /admin (source management).
# Unset = nobody is admin (safe default). Matched case-insensitively, trimmed.
ADMIN_EMAILS=you@example.com,teammate@example.com

# Optional: BestTime crowd data. Falls back to a heuristic if unset.
BESTTIME_PRIVATE_KEY=

# LINE bot (C5 group candidate ingest) — only needed if using the /api/line/webhook.
# LINE_CHANNEL_SECRET verifies the webhook signature; ACCESS_TOKEN sends replies.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
